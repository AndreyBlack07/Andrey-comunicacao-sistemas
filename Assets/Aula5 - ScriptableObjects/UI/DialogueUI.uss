.dialogue-screen {
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    padding: 32px;
    background-color: rgba(0, 0, 0, 0.35);
}

.dialogue-panel {
    width: 80%;
    max-width: 900px;
    padding: 24px;
    background-color: rgba(18, 24, 32, 0.96);
    border-left-width: 5px;
    border-left-color: rgb(68, 190, 170);
}

.speaker-label {
    margin-bottom: 12px;
    color: rgb(105, 224, 201);
    font-size: 24px;
    -unity-font-style: bold;
}

.dialogue-label {
    margin-bottom: 20px;
    color: rgb(245, 247, 250);
    font-size: 20px;
    white-space: normal;
}

.choices-root {
    flex-direction: column;
    align-items: stretch;
}

.dialogue-choice {
    min-height: 44px;
    margin-top: 8px;
    padding: 10px 14px;
    color: rgb(245, 247, 250);
    background-color: rgb(42, 58, 70);
    border-left-width: 3px;
    border-left-color: rgb(68, 190, 170);
    font-size: 18px;
    -unity-text-align: middle-left;
}

.dialogue-choice:hover {
    background-color: rgb(56, 82, 92);
}

.dialogue-choice:focus {
    border-left-color: rgb(255, 205, 90);
}
